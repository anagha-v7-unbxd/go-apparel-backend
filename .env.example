# Database (PostgreSQL) - required for ingest, browse, delete
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_db

# Redis - optional; used for caching browse/search (app runs without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App (optional overrides)
# APP_LOG_LEVEL=debug
# APP_HTTP_PORT=6060
